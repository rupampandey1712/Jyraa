# Database Configuration
DATABASE_SERVER=mssql+pyodbc://@localhost\SQLEXPRESS02/JiraDB?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# JWT Configuration
SECRET_KEY=change-this-to-a-very-secure-random-key-at-least-32-characters-long
ALGORITHM=HS256
# 30 days
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS
FRONTEND_URL=http://localhost:3000

# NVIDIA NIM / LangChain ChatNVIDIA
NVIDIA_API_KEY=your-nvidia-api-key
NIM_API_KEY=
NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# SMTP / Gmail automation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_USE_TLS=true

# MCP endpoint protection. When set, clients must send:
# Authorization: Bearer <token>
MCP_API_TOKEN=
